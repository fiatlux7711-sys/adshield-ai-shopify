# Shopify CLI supplies these automatically during `shopify app dev` after linking.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# Optional AI analysis through Vercel AI Gateway.
# Deterministic compliance rules work without this key.
AI_GATEWAY_API_KEY=
ADSHIELD_AI_ENABLED=true
ADSHIELD_AI_MODEL=spacexai/grok-4.6

# Maximum products per manual scan. Keep bounded until background jobs are added.
ADSHIELD_SCAN_LIMIT=250

# Database connection. SQLite for local development only.
# Production must use managed PostgreSQL — see docs/PRODUCTION_DATABASE.md
#   local: file:dev.sqlite
#   prod:  postgresql://USER:PASSWORD@HOST:5432/adshield?sslmode=require
DATABASE_URL=file:dev.sqlite

# Background scan worker.
ADSHIELD_MAX_CONCURRENT_SCANS=2
ADSHIELD_SCAN_MAX_ATTEMPTS=3

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
